rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify user identity
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check household membership and roles
    function isHouseholdMember(householdId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }
    
    function getHouseholdRole(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role;
    }
    
    function isHouseholdEditorOrOwner(householdId) {
      return isHouseholdMember(householdId) && 
        (getHouseholdRole(householdId) == 'Editor' || getHouseholdRole(householdId) == 'Owner');
    }
    
    function isHouseholdOwner(householdId) {
      return isHouseholdMember(householdId) && getHouseholdRole(householdId) == 'Owner';
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read, write: if isUser(userId);
    }
    
    // PRODUCTS COLLECTION
    match /products/{productId} {
      // Personal product: only owner can read/write
      // Shared household product: household members can read, Editors & Owners can write
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdMember(resource.data.householdId))
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.purchasePrice is number &&
        request.resource.data.purchasePrice >= 0
      );
      
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdEditorOrOwner(resource.data.householdId))
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.householdId != null && isHouseholdOwner(resource.data.householdId))
      );
      
      // SERVICE RECORDS SUBCOLLECTION
      match /serviceRecords/{serviceId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid ||
          isHouseholdMember(get(/databases/$(database)/documents/products/$(productId)).data.householdId)
        );
        allow write: if isAuthenticated() && (
          get(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid ||
          isHouseholdEditorOrOwner(get(/databases/$(database)/documents/products/$(productId)).data.householdId)
        );
      }
    }
    
    // HOUSEHOLDS COLLECTION
    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isHouseholdOwner(householdId);
      
      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdOwner(householdId);
      }
    }
    
    // NOTIFICATIONS & ALERTS
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // USER SETTINGS
    match /userSettings/{userId} {
      allow read, write: if isUser(userId);
    }
  }
}
